generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                         String               @id @default(uuid())
  fullName                   String
  email                      String               @unique
  phoneNumber                String?
  username                   String?
  profilePhotoUrl            String?
  authProvider               AuthProvider         @default(EMAIL_PASSWORD)
  passwordHash               String?
  createdAt                  DateTime             @default(now())
  updatedAt                  DateTime             @updatedAt
  googleId                   String?              @unique
  activities                 Activity[]           @relation("ActivityActor")
  createdExpenses            Expense[]            @relation("ExpenseCreator")
  paidExpenses               Expense[]            @relation("ExpensePayer")
  expenseParticipations      ExpenseParticipant[]
  friendshipsAsUser1         Friendship[]         @relation("FriendshipUser1")
  friendshipsAsUser2         Friendship[]         @relation("FriendshipUser2")
  ownedGroups                Group[]              @relation("GroupOwner")
  groupMemberships           GroupMember[]
  ownershipTransfersStarted  OwnershipTransfer[]  @relation("CurrentOwner")
  ownershipTransfersReceived OwnershipTransfer[]  @relation("ProposedOwner")
  settlementsPaid            Settlement[]         @relation("SettlementPayer")
  settlementsReceived        Settlement[]         @relation("SettlementReceiver")
}

model Friendship {
  id        String   @id @default(uuid())
  user1Id   String
  user2Id   String
  createdAt DateTime @default(now())
  user1     User     @relation("FriendshipUser1", fields: [user1Id], references: [id])
  user2     User     @relation("FriendshipUser2", fields: [user2Id], references: [id])

  @@unique([user1Id, user2Id])
}

model Group {
  id                 String              @id @default(uuid())
  name               String
  ownerId            String
  inviteCode         String              @unique
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  activities         Activity[]
  expenses           Expense[]
  owner              User                @relation("GroupOwner", fields: [ownerId], references: [id])
  members            GroupMember[]
  ownershipTransfers OwnershipTransfer[]
  settlements        Settlement[]
}

model GroupMember {
  id       String   @id @default(uuid())
  groupId  String
  userId   String
  joinedAt DateTime @default(now())
  group    Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id])

  @@unique([groupId, userId])
}

model Expense {
  id           String               @id @default(uuid())
  description  String
  amount       Decimal
  splitType    SplitType
  payerId      String
  creatorId    String
  groupId      String?
  receiptUrl   String?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  creator      User                 @relation("ExpenseCreator", fields: [creatorId], references: [id])
  group        Group?               @relation(fields: [groupId], references: [id], onDelete: Cascade)
  payer        User                 @relation("ExpensePayer", fields: [payerId], references: [id])
  participants ExpenseParticipant[]
}

model ExpenseParticipant {
  id         String   @id @default(uuid())
  expenseId  String
  userId     String
  amountOwed Decimal
  percentage Decimal?
  shares     Int?
  expense    Expense  @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id])

  @@unique([expenseId, userId])
}

model Settlement {
  id            String   @id @default(uuid())
  amount        Decimal
  payerId       String
  receiverId    String
  groupId       String?
  note          String?
  screenshotUrl String?
  createdAt     DateTime @default(now())
  group         Group?   @relation(fields: [groupId], references: [id], onDelete: Cascade)
  payer         User     @relation("SettlementPayer", fields: [payerId], references: [id])
  receiver      User     @relation("SettlementReceiver", fields: [receiverId], references: [id])
}

model Activity {
  id           String       @id @default(uuid())
  actorId      String
  groupId      String?
  activityType ActivityType
  entityId     String?
  metadata     Json?
  createdAt    DateTime     @default(now())
  actor        User         @relation("ActivityActor", fields: [actorId], references: [id])
  group        Group?       @relation(fields: [groupId], references: [id])
}

model OwnershipTransfer {
  id              String                  @id @default(uuid())
  groupId         String
  currentOwnerId  String
  proposedOwnerId String
  status          OwnershipTransferStatus @default(PENDING)
  createdAt       DateTime                @default(now())
  respondedAt     DateTime?
  currentOwner    User                    @relation("CurrentOwner", fields: [currentOwnerId], references: [id])
  group           Group                   @relation(fields: [groupId], references: [id], onDelete: Cascade)
  proposedOwner   User                    @relation("ProposedOwner", fields: [proposedOwnerId], references: [id])
}

enum AuthProvider {
  GOOGLE
  EMAIL_PASSWORD
}

enum SplitType {
  EQUAL
  UNEQUAL
  PERCENTAGE
  SHARE
}

enum OwnershipTransferStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum ActivityType {
  EXPENSE_CREATED
  EXPENSE_UPDATED
  EXPENSE_DELETED
  SETTLEMENT_CREATED
  MEMBER_ADDED
  MEMBER_REMOVED
  GROUP_RENAMED
  OWNERSHIP_TRANSFERRED
  GROUP_DELETED
  GROUP_CREATED
}
